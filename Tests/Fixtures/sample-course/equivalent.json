{
  "schema_version": 1,
  "id": "sample-course",
  "title": "Local Course Basics",
  "subtitle": "A course for the Skillgarden sample",
  "description": "Learn how to plan and complete a local course.",
  "learning_outcomes": [
    "Plan a course",
    "Check your work"
  ],
  "requirements": [
    "A Mac"
  ],
  "target_audience": "New learners",
  "state": "published",
  "theme": {
    "accent_color": "#286644",
    "appearance": "light"
  },
  "course_image": {
    "path": "media/course.svg",
    "alt": "A green garden with two plants"
  },
  "credits": [
    {
      "name": "Skillgarden Team",
      "role": "Author",
      "url": "https://example.com/credits"
    }
  ],
  "sections": [
    {
      "id": "plan",
      "title": "Plan the course",
      "objective": "Identify the course structure",
      "state": "published",
      "order": 0,
      "header_image": {
        "path": "media/section.svg",
        "alt": "Two course sections"
      },
      "lectures": [
        {
          "id": "welcome",
          "title": "Welcome",
          "type": "video",
          "objective": "Identify the course goal",
          "state": "published",
          "order": 0,
          "recommended_next": "read",
          "video": {
            "path": "content/welcome.mp4",
            "duration_seconds": 4,
            "captions": { "path": "content/welcome.vtt" },
            "poster": { "path": "media/poster.svg", "alt": "The first frame of the welcome video" },
            "free_preview": true,
            "quick_checks": [
              {
                "prompt": "Where does a Skillgarden course live?",
                "choices": [
                  { "id": "local", "text": "On this Mac" },
                  { "id": "server", "text": "On a web server" }
                ],
                "correct_choice_id": "local"
              },
              {
                "prompt": "What does the course outline show first?",
                "choices": [
                  { "id": "sections", "text": "The sections, in order" },
                  { "id": "scores", "text": "The quiz scores" }
                ],
                "correct_choice_id": "sections",
                "explanation": "The outline lists the sections in order, and each section lists its lectures."
              }
            ]
          }
        },
        {
          "id": "read",
          "title": "Read the plan",
          "type": "article",
          "objective": "Describe the course plan",
          "state": "published",
          "order": 1,
          "article": {
            "path": "content/plan.md",
            "images": [
              {
                "path": "media/section.svg",
                "alt": "The two sections of the course plan"
              }
            ]
          },
          "sources": [
            {
              "title": "Plan a course on one page",
              "channel": "Skillgarden Studio",
              "url": "https://example.com/plan-a-course",
              "timestamp_start": 250,
              "timestamp_end": 572
            },
            {
              "title": "Course outlines that work",
              "channel": "Learning Lab",
              "url": "https://example.com/course-outlines",
              "timestamp_start": 3725
            },
            {
              "title": "The course plan checklist",
              "channel": "Skillgarden Docs"
            }
          ]
        }
      ]
    },
    {
      "id": "practice",
      "title": "Check your work",
      "objective": "Apply the course plan",
      "state": "draft",
      "order": 1,
      "header_image": {
        "path": "media/section.svg",
        "alt": "Two course sections"
      },
      "lectures": [
        {
          "id": "check",
          "title": "Check the plan",
          "type": "quiz",
          "objective": "Select the correct plan",
          "state": "published",
          "order": 0,
          "quiz": {
            "questions": [
              {
                "id": "outline",
                "prompt": "What does this course outline show?",
                "image": {
                  "path": "media/section.svg",
                  "alt": "Two course sections"
                },
                "objective_tag": "Read a course outline",
                "choices": [
                  { "id": "sections", "text": "Two sections" },
                  { "id": "lectures", "text": "Two lectures" },
                  { "id": "quizzes", "text": "Two quizzes" }
                ],
                "correct_choice_id": "sections",
                "explanation": "Each column is one section. A course outline shows its sections in order."
              },
              {
                "id": "order",
                "prompt": "Which section comes first in the outline?",
                "objective_tag": "Order course sections",
                "choices": [
                  { "id": "lowest", "text": "The section with the lowest order value" },
                  { "id": "newest", "text": "The section that you added last" }
                ],
                "correct_choice_id": "lowest",
                "explanation": "The outline sorts sections by their order value, from low to high."
              },
              {
                "id": "goal",
                "prompt": "What does a lecture objective tell the learner?",
                "objective_tag": "Check a lecture objective",
                "choices": [
                  { "id": "skill", "text": "The skill that the lecture teaches" },
                  { "id": "length", "text": "The length of the lecture" }
                ],
                "correct_choice_id": "skill",
                "explanation": "An objective names the skill that the learner gets from the lecture."
              }
            ]
          }
        },
        {
          "id": "apply",
          "title": "Write a plan",
          "type": "assignment",
          "objective": "Create a course plan",
          "state": "draft",
          "order": 1,
          "assignment": {
            "brief": { "path": "content/brief.md" },
            "rubric": [
              {
                "id": "goal",
                "criterion": "The plan states one course goal",
                "guidance": "Write the goal in one sentence that names the skill."
              },
              {
                "id": "sections",
                "criterion": "The plan has two sections with objectives",
                "guidance": "Each section objective starts with a verb, for example \"Identify\"."
              },
              {
                "id": "order",
                "criterion": "The lectures are in a clear order",
                "guidance": "Each lecture builds on the lecture before it."
              },
              {
                "id": "length",
                "criterion": "The plan fits on one page",
                "guidance": "Cut detail that the learner does not need."
              }
            ]
          }
        }
      ]
    }
  ],
  "internal": {
    "files": [
      {
        "path": "internal/research.md",
        "title": "Research brief",
        "description": "Team notes for the course plan"
      },
      {
        "path": "internal/transcript.vtt",
        "title": "Transcript pack"
      }
    ]
  }
}
